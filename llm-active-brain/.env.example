# Provedor de LLM: "nvidia" (padrao) ou "groq". Ambos tem free tier e
# endpoint compativel com a API da OpenAI. Troque se um deles estiver com
# limite de cota curto demais ou fora do ar - so precisa da chave do
# provedor escolhido preenchida abaixo.
LLM_PROVIDER=nvidia

# Chave gratuita da NVIDIA (build.nvidia.com/settings/api-keys), necessaria
# se LLM_PROVIDER=nvidia.
NVIDIA_API_KEY=

# Chave gratuita do Groq (console.groq.com/keys), necessaria se
# LLM_PROVIDER=groq.
GROQ_API_KEY=

# Sobrescreve o modelo/base URL padrao do provedor escolhido (opcional).
# Precisa suportar tool/function calling.
# NVIDIA: lista em https://build.nvidia.com/models (filtre por "function calling")
# Groq: curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=

# Chave privada da carteira de TESTNET (gerada por `npm run setup-wallet`).
# NUNCA coloque aqui uma chave privada de uma carteira com fundos reais.
AGENT_PRIVATE_KEY=

# RPC da Base Sepolia (testnet). Pode usar o publico do proprio viem
# (deixe em branco) ou um endpoint dedicado (Alchemy/Infura testnet).
BASE_SEPOLIA_RPC_URL=

# Limites de seguranca do experimento
MAX_ITERATIONS=15
MAX_TX_VALUE_ETH=0.0002

# Modo continuo: roda varios ciclos de decisao em sequencia (true/false).
# Cada ciclo e uma "sessao" completa do agente (com ate MAX_ITERATIONS passos).
CONTINUOUS_MODE=false
CYCLE_DELAY_SECONDS=30
MAX_CYCLES=100

# Trading real/testnet via Binance (opcional - so ativa se ENABLE_TRADING=true).
# TESTNET: gere chaves gratis em https://testnet.binance.vision (login com GitHub).
# LIVE: gere chaves na sua conta real em binance.com > API Management,
# com permissao de "Enable Spot Trading" e SEM permissao de saque (withdraw).
ENABLE_TRADING=false
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# true = testnet, dinheiro simulado (padrao, recomendado). false = dinheiro REAL.
BINANCE_TESTNET=true
# 5 = minimo tipico de ordem na Binance (varia por par; abaixo disso a
# maioria das ordens e recusada com "Filter failure: NOTIONAL")
MAX_ORDER_USD=5
# Teto RIGIDO combinado para todo o experimento em modo LIVE (nao pode passar de 5).
MAX_LIVE_BUDGET_USD=5

# Ponte opcional pro Neural Day Trader: espelha cada ordem executada aqui
# como um trade virtual isolado em ai_trades/ai_sessions daquele projeto
# (Supabase "Neural DayTrader", projeto wyvdsxtcmizettljxtbg), pra o
# resultado aparecer no Dashboard da plataforma enquanto o agente roda
# neste terminal. So ativa se NEURAL_BRIDGE_ENABLED=true; se falhar, nunca
# derruba o agente (so loga o erro).
NEURAL_BRIDGE_ENABLED=false
NEURAL_SUPABASE_URL=
NEURAL_SUPABASE_SERVICE_ROLE_KEY=
# Anon key do MESMO projeto Supabase (nao a service role) -- necessaria so
# quando MT5_LIVE_EXECUTION_ENABLED=true, pra trocar o magic link por uma
# sessao real de usuario (ver liveExecution.ts). Nao e segredo sensivel (e a
# mesma chave publica que o frontend ja usa), mas mantida aqui por padrao de
# organizacao com as outras NEURAL_SUPABASE_*.
NEURAL_SUPABASE_ANON_KEY=
NEURAL_USER_ID=

# 🔴 2026-09-08: execucao REAL (dinheiro de verdade) na Infinox via MetaAPI --
# ver liveExecution.ts e CLAUDE.md (item de reconexao da conta LIVE). NUNCA
# ligar sem: (1) broker_credentials do usuario conectado pela UI do app;
# (2) entender que e um trilho de codigo novo, nunca testado em producao;
# (3) ciente do circuit breaker automatico (qualquer erro desliga ate
# restart manual) e do teto de perda ABSOLUTO em dolar abaixo.
MT5_LIVE_EXECUTION_ENABLED=false
MT5_LIVE_ABSOLUTE_LOSS_LIMIT_USD=3
